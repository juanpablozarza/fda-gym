# Copy to .env and fill in. Never commit .env.

# Free at https://open.fda.gov/apis/authentication/
# Without it: 1,000 requests/day. With it: 120,000/day.
OPENFDA_API_KEY=

# https://openrouter.ai/keys
# One key covers GPT, Claude, and Qwen for baselines and the LLM judge.
OPENROUTER_API_KEY=

# Private hard-eval generator. Unset on purpose; there is no default seed in
# this repo. Export integer values only in a private checkout that generates a
# new held-out sheet. Do not commit them.
# FDAGYM_HARD_SEED=
# FDAGYM_HARD_ID_START=
